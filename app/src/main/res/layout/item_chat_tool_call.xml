<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Header: icon + tool name + status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_tool_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_public"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_tool_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress_tool"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true"
                    style="@style/Widget.Material3.CircularProgressIndicator.Small" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Arguments: collapsible -->
            <TextView
                android:id="@+id/tv_arguments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_streaming_content"
                android:fontFamily="monospace"
                android:maxLines="3"
                android:padding="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <!-- Result: shown after execution -->
            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_streaming_content"
                android:fontFamily="monospace"
                android:maxLines="15"
                android:ellipsize="end"
                android:padding="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
